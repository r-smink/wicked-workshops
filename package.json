{
  "name": "wicked-workshops",
  "private": true,
  "description": "Monorepo: web/ (Next.js) en directus/ (Directus, lokaal zonder Docker). Deze scripts zijn alleen doorverwijzingen.",
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "dev:directus": "npm --prefix directus run dev",
    "migrate": "npm --prefix directus run migrate",
    "seed": "npm --prefix directus run seed",
    "seed:demo": "npm --prefix directus run seed:demo",
    "directus:types": "npm --prefix web run directus:types",
    "test:permissions": "npm --prefix directus run test:permissions"
  }
}
