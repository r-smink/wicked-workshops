# Lokale Directus. `npm run dev` maakt directus/.env zelf aan op basis van
# dit bestand en vult lege waarden met willekeurige geheimen.
# directus/.env staat in .gitignore.

DIRECTUS_KEY=
DIRECTUS_SECRET=

DB_PORT=5433
DB_USER=directus
DB_PASSWORD=
DB_DATABASE=directus

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Statisch token van de lokale beheerder, voor de scripts en de rechtentest.
ADMIN_TOKEN=

MAIL_FROM=Wicked Workshops <noreply@wickedworkshops.test>
