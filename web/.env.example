# Voorbeeld voor web/.env.local. Zet dezelfde namen op Vercel.
# Nooit echte waarden in dit bestand.

# Publieke URL van de site: links in mails, return_url bij OPP
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Directus. Lokaal: http://localhost:8055 met ADMIN_TOKEN uit directus/.env
DIRECTUS_URL=http://localhost:8055
DIRECTUS_STATIC_TOKEN=
# Publieke URL van de Directus-beheeromgeving, voor links in teammails
DIRECTUS_PUBLIC_URL=
# Rol voor nieuwe accounts. Leeg = de rol "Member" wordt opgezocht.
DIRECTUS_ROLE_MEMBER=
# Oude rollen, alleen nog voor bestaande accounts
DIRECTUS_ROLE_CUSTOMER=
DIRECTUS_ROLE_PROVIDER=

# Mail (nodemailer). Lokaal Mailpit: smtp://127.0.0.1:1025
SMTP_URL=
MAIL_FROM=Wicked Workshops <hallo@wickedworkshops.nl>
# Waar klachten binnenkomen als platform_settings.team_email leeg is
TEAM_EMAIL=

# OPP (betalen). Pilot: alleen sandbox. Live op zijn vroegst januari 2027.
OPP_SANDBOX_API_KEY=
OPP_SANDBOX_NOTIFY_SECRET=
OPP_LIVE_API_KEY=
OPP_LIVE_NOTIFY_SECRET=

# Geheimen
# Cron (/api/cron/escrow, .github/workflows/cron.yml)
CRON_SECRET=
# Knoppen voor het team in Directus (/api/team/actions); gelijk aan directus/.env
TEAM_ACTION_SECRET=
# Beheerlinks in mails (HMAC). Wijzigen maakt alle oude links ongeldig.
BOOKING_LINK_SECRET=
# Versleuteling van gevoelige velden (IBAN)
FIELD_ENCRYPTION_KEY=
# Revalidatie vanuit Directus webhooks
REVALIDATE_SECRET=

# Geldigheid van links in uren (docs/04). Standaard 24 en 1.
AUTH_VERIFY_HOURS=
AUTH_RESET_HOURS=

# Google
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_ID=
GOOGLE_GEOCODING_KEY=

# Alleen lokaal: /dev-routes
ENABLE_DEV_ROUTES=
